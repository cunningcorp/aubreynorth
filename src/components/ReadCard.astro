---
import { LANES, type LaneKey } from '../consts';
interface Props {
  slug: string;
  title: string;
  description: string;
  lane: LaneKey;
  pubDate: Date;
}
const { slug, title, description, lane, pubDate } = Astro.props;
const laneMeta = LANES[lane];
const iso = pubDate.toISOString().split('T')[0];
const fmt = pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card" data-reveal>
  <a class="card__link" href={`/reads/${slug}/`}>
    <div class="card__meta">
      <span class="card__lane">{laneMeta.label}</span>
      <time datetime={iso} class="card__date">{fmt}</time>
    </div>
    <h2 class="card__title">{title}</h2>
    <p class="card__desc">{description}</p>
    <span class="card__more">Read →</span>
  </a>
</article>

<style>
  .card {
    border-top: 1px solid rgba(27, 26, 23, 0.12);
  }
  .card__link {
    display: block;
    padding: 40px 0;
    text-decoration: none;
    color: inherit;
  }
  .card__meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }
  .card__lane {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .card__date {
    font-size: 13px;
    color: var(--muted);
  }
  .card__title {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.012em;
    margin: 0 0 14px;
    color: var(--ink);
    text-wrap: pretty;
    transition: color 0.2s ease;
  }
  .card__link:hover .card__title {
    color: var(--rust);
  }
  .card__desc {
    font-size: 17px;
    line-height: 1.55;
    color: var(--body);
    margin: 0 0 18px;
    max-width: 620px;
  }
  .card__more {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card__link:hover .card__more {
    color: var(--rust);
  }
</style>
