---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ReadCard from '../../components/ReadCard.astro';
import { SITE, LANES } from '../../consts';

const reads = (await getCollection('reads', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Reads — Aubrey North';
const description =
  'Reads from Aubrey North — short pieces on narrative, restraint and the story a business is actually telling. Screen, Type and Business.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Reads',
  url: new URL('/reads/', SITE.url).href,
  description,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Nav />

  <main class="reads">
    <header class="wrap reads__head" data-reveal>
      <p class="reads__eyebrow">The Reads</p>
      <h1 class="reads__h1">Short pieces on the story underneath.</h1>
      <p class="reads__lede">
        One idea at a time, held to the same bar as the work. Three lanes.
      </p>
      <nav class="reads__lanes" aria-label="Read lanes">
        {
          Object.values(LANES).map((l) => (
            <a href={`/reads/${l.slug}/`} class="reads__lane">
              {l.label}
            </a>
          ))
        }
      </nav>
    </header>

    <section class="wrap reads__list">
      {
        reads.length === 0 ? (
          <p class="reads__empty">The first Read is on its way.</p>
        ) : (
          reads.map((entry) => (
            <ReadCard
              slug={entry.id}
              title={entry.data.title}
              description={entry.data.description}
              lane={entry.data.lane}
              pubDate={entry.data.pubDate}
            />
          ))
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .reads__head {
    padding-top: 88px;
    padding-bottom: 56px;
  }
  .reads__eyebrow {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 22px;
  }
  .reads__h1 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(34px, 5.4vw, 60px);
    line-height: 1.06;
    letter-spacing: -0.018em;
    margin: 0 0 22px;
    color: var(--ink);
    text-wrap: pretty;
    max-width: 720px;
  }
  .reads__lede {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.6;
    color: var(--body);
    margin: 0 0 34px;
    max-width: 560px;
  }
  .reads__lanes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .reads__lane {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid rgba(27, 26, 23, 0.18);
    border-radius: 999px;
    padding: 9px 18px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .reads__lane:hover {
    color: var(--rust);
    border-color: var(--rust);
  }
  .reads__list {
    padding-bottom: 96px;
    border-bottom: 1px solid rgba(27, 26, 23, 0.12);
  }
  .reads__empty {
    padding: 40px 0;
    border-top: 1px solid rgba(27, 26, 23, 0.12);
    font-size: 18px;
    color: var(--muted);
  }
</style>
