---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrbitMark from '../components/OrbitMark.astro';
import SayLess from '../components/SayLess.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../consts';

// Engagement tiers — reused verbatim from the live design source.
const tiers = [
  { no: '01', name: 'Coffee + Chat', desc: 'A relaxed, focused conversation about how you see the business and where the friction is.', price: 'Complimentary' },
  { no: '02', name: 'The One Recommendation', desc: 'A single, focused fix on the most critical issue, delivered as an Aubrey North Note.', price: '£500' },
  { no: '03', name: 'Weekly Intensive', desc: 'Focused weekly sprints to identify and fix the core narrative issues. Most run two to three weeks.', price: '£2,500 / week' },
  { no: '04', name: 'Ongoing Advisory', desc: 'By invitation, billed monthly. For businesses that want a steady hand on the narrative over time.', price: '£1–2k / week' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    description: 'Narrative advisory. A Cunning Corp company.',
    parentOrganization: { '@type': 'Organization', name: 'Cunning Corp' },
    logo: new URL('/og-default.svg', SITE.url).href,
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <Nav contactHref="#contact" />

  <main>
    <!-- HERO -->
    <header class="hero wrap">
      <OrbitMark class="hero__deco" orbit="9s" />
      <div class="hero__mark" data-reveal>
        <span class="hero__wordmark">AUBREY&nbsp;NORTH</span>
      </div>
      <div class="hero__body" data-reveal>
        <p class="eyebrow eyebrow--rust">Narrative Advisory</p>
        <h1 class="hero__h1">
          We help businesses define the story people
          <em>actually</em> understand.
        </h1>
        <p class="hero__lede">
          Not branding. Not marketing. We work upstream of both, on the
          narrative they both depend on.
        </p>
        <div class="hero__actions">
          <a href="#contact" class="btn btn--dark">Start a conversation</a>
          <span class="hero__note">Complimentary. No obligation.</span>
        </div>
      </div>
    </header>

    <!-- THE HOOK -->
    <section class="section section--rule">
      <div class="wrap section__pad">
        <p class="eyebrow" data-reveal>The problem we name</p>
        <h2 class="hook__h2" data-reveal>
          If your business isn't converting the way it should, the problem
          usually isn't marketing. It's that no one understands who you are.
        </h2>
        <div class="hook__cols" data-reveal>
          <p class="hook__col">
            Marketing only amplifies a message. If the message underneath is
            unclear, louder just means more people hear something confusing.
          </p>
          <p class="hook__col hook__col--strong">
            You don't have a reach problem. You have a
            <span class="rust">clarity</span> problem.
          </p>
        </div>
      </div>
    </section>

    <!-- WHERE WE SIT -->
    <section class="section section--rule">
      <div class="wrap section__pad">
        <p class="eyebrow" data-reveal>Where we sit</p>
        <h2 class="sit__h2" data-reveal>
          Get the story right and branding has something true to dress, and
          marketing has something clear to carry.
        </h2>
        <div class="sit__grid">
          <div class="sit__cell" data-reveal>
            <p class="sit__no">01 · Branding</p>
            <p class="sit__line">makes you <br />recognisable.</p>
          </div>
          <div class="sit__cell sit__cell--mid" data-reveal>
            <p class="sit__no">02 · Marketing</p>
            <p class="sit__line">makes you <br />heard.</p>
          </div>
          <div class="sit__cell sit__cell--accent" data-reveal>
            <p class="sit__no sit__no--rust">03 · Narrative</p>
            <p class="sit__line">makes you <em class="rust">understood.</em></p>
            <p class="sit__foot">We do the third — so the first two can work.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SAY LESS -->
    <section id="sayless" class="dark">
      <OrbitMark class="dark__deco" orbit="11s" />
      <div class="wrap section__pad dark__inner">
        <p class="eyebrow eyebrow--rust" data-reveal>The 1/8th principle</p>
        <h2 class="sayless__h2" data-reveal>
          We don't help you say more. We help you say <em class="rust">less</em>,
          and make it land.
        </h2>
        <p class="sayless__lede" data-reveal>
          You don't pitch everything you can do. We help you choose the eighth
          that lands — the one that earns you the right to the rest. Try it:
        </p>
        <div data-reveal>
          <SayLess />
        </div>
        <p class="sayless__foot" data-reveal>
          Restraint is the craft. We subtract until it's true.
        </p>
      </div>
    </section>

    <!-- HOW WE WORK -->
    <section id="work" class="section section--rule">
      <div class="wrap section__pad">
        <div class="work__head">
          <div data-reveal>
            <p class="eyebrow">How we work</p>
            <h2 class="work__h2">
              We work in the next three to six months — not the next ten years.
            </h2>
          </div>
          <p class="work__aside" data-reveal>Boutique by design. Select markets.</p>
        </div>
        <div class="work__list">
          {
            tiers.map((tier) => (
              <div class="tier" data-reveal>
                <span class="tier__no">{tier.no}</span>
                <div>
                  <h3 class="tier__name">{tier.name}</h3>
                  <p class="tier__desc">{tier.desc}</p>
                </div>
                <span class="tier__price">{tier.price}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="dark dark--rule">
      <OrbitMark class="contact__deco" orbit="12s" />
      <div class="wrap section__pad contact__grid">
        <div data-reveal>
          <p class="eyebrow eyebrow--rust">Coffee + Chat</p>
          <h2 class="contact__h2">
            A relaxed conversation about where the friction is.
          </h2>
          <p class="contact__body">
            Tell us about the business, where it is, where you want it — and most
            of all, what you want a customer to feel on contact. Complimentary.
            No obligation.
          </p>
          <div class="contact__mark">
            <span class="contact__the">the</span>
            <span class="contact__name">AUBREY&nbsp;NORTH</span>
            <span class="contact__co">company</span>
          </div>
        </div>
        <div data-reveal>
          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Shared section rhythm */
  .section--rule {
    border-top: 1px solid rgba(27, 26, 23, 0.1);
  }
  .section__pad {
    padding-top: 108px;
    padding-bottom: 108px;
  }
  .eyebrow {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 22px;
  }
  .eyebrow--rust {
    color: var(--rust);
  }
  .rust {
    color: var(--rust);
  }
  em.rust,
  .hero__h1 em {
    font-style: italic;
    color: var(--rust);
  }
  .btn {
    display: inline-block;
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 16px 30px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .btn--dark {
    color: #f1ece2;
    background: var(--ink);
  }
  .btn--dark:hover {
    background: var(--rust);
    transform: translateY(-2px);
  }

  /* HERO */
  .hero {
    padding-top: 104px;
    padding-bottom: 92px;
    position: relative;
  }
  .hero__deco {
    top: 108px;
    right: 46px;
    width: 146px;
    height: 146px;
  }
  .hero__mark {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    flex-wrap: wrap;
    margin-bottom: 46px;
  }
  .hero__wordmark {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: clamp(22px, 6.4vw, 58px);
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: 0.9;
  }
  .hero__body {
    max-width: 880px;
  }
  .hero__h1 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(34px, 6vw, 72px);
    line-height: 1.04;
    letter-spacing: -0.018em;
    margin: 0 0 30px;
    text-wrap: pretty;
    color: var(--ink);
  }
  .hero__lede {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.6;
    color: var(--body);
    max-width: 620px;
    margin: 0 0 40px;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .hero__note {
    font-size: 15px;
    color: #8a8378;
  }

  /* THE HOOK */
  .hook__h2 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(28px, 4.4vw, 52px);
    line-height: 1.14;
    letter-spacing: -0.012em;
    margin: 0 0 34px;
    max-width: 960px;
    text-wrap: pretty;
    color: var(--ink);
  }
  .hook__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 40px;
    max-width: 920px;
    margin-top: 18px;
  }
  .hook__col {
    font-size: 18px;
    line-height: 1.62;
    color: var(--body);
    margin: 0;
  }
  .hook__col--strong {
    font-size: 22px;
    line-height: 1.4;
    color: var(--ink);
  }

  /* WHERE WE SIT */
  .sit__h2 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(26px, 3.6vw, 42px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    margin: 0 0 64px;
    max-width: 760px;
    text-wrap: pretty;
    color: var(--ink);
  }
  .sit__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    border-top: 1px solid rgba(27, 26, 23, 0.14);
  }
  .sit__cell {
    padding: 38px 32px 38px 0;
    border-bottom: 1px solid rgba(27, 26, 23, 0.1);
  }
  .sit__cell--mid {
    padding-left: 32px;
    border-left: 1px solid rgba(27, 26, 23, 0.1);
  }
  .sit__cell--accent {
    padding: 38px 0 38px 32px;
    border-bottom: 1px solid var(--rust);
    border-left: 1px solid rgba(27, 26, 23, 0.1);
    position: relative;
  }
  .sit__no {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .sit__no--rust {
    color: var(--rust);
  }
  .sit__line {
    font-family: var(--font-headline);
    font-size: 27px;
    line-height: 1.2;
    margin: 0;
    color: var(--ink);
  }
  .sit__foot {
    font-size: 14px;
    color: var(--muted);
    margin: 18px 0 0;
  }
  @media (max-width: 640px) {
    .sit__cell,
    .sit__cell--mid,
    .sit__cell--accent {
      padding-left: 0;
      padding-right: 0;
      border-left: none;
    }
  }

  /* DARK sections */
  .dark {
    background: var(--dark);
    color: #f1ece2;
    position: relative;
    overflow: hidden;
  }
  .dark--rule {
    border-top: 1px solid rgba(27, 26, 23, 0.1);
  }
  .dark__deco {
    top: 84px;
    right: 64px;
    width: 120px;
    height: 120px;
  }
  .dark__inner {
    position: relative;
    padding-top: 116px;
    padding-bottom: 116px;
  }
  .sayless__h2 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(30px, 5vw, 60px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    margin: 0 0 20px;
    max-width: 840px;
    text-wrap: pretty;
    color: var(--paper);
  }
  .sayless__lede {
    font-size: 18px;
    line-height: 1.6;
    color: #b3ab9c;
    max-width: 600px;
    margin: 0 0 56px;
  }
  .sayless__foot {
    font-size: 14px;
    color: #6f6a60;
    margin: 22px 0 0;
    font-style: italic;
  }

  /* HOW WE WORK */
  .work__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .work__h2 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.012em;
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
    color: var(--ink);
  }
  .work__aside {
    font-size: 15px;
    color: var(--muted);
    max-width: 240px;
    margin: 0;
  }
  .work__list {
    border-top: 1px solid rgba(27, 26, 23, 0.16);
  }
  .tier {
    display: grid;
    grid-template-columns: 54px 1fr auto;
    gap: 28px;
    align-items: start;
    padding: 34px 0;
    border-bottom: 1px solid rgba(27, 26, 23, 0.1);
  }
  .tier__no {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 14px;
    color: var(--rust);
    padding-top: 6px;
  }
  .tier__name {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.12;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .tier__desc {
    font-size: 16px;
    line-height: 1.55;
    color: #6f6a60;
    margin: 0;
    max-width: 560px;
  }
  .tier__price {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: clamp(16px, 1.8vw, 21px);
    color: var(--ink);
    white-space: nowrap;
    text-align: right;
    padding-top: 4px;
  }
  @media (max-width: 640px) {
    .tier {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .tier__price {
      text-align: left;
      padding-top: 6px;
    }
  }

  /* CONTACT */
  .contact__deco {
    bottom: 72px;
    left: 50%;
    top: auto;
    right: auto;
    width: 104px;
    height: 104px;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 64px;
    position: relative;
    padding-top: 116px;
    padding-bottom: 116px;
  }
  .contact__h2 {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.014em;
    margin: 0 0 26px;
    text-wrap: pretty;
    color: var(--paper);
  }
  .contact__body {
    font-size: 18px;
    line-height: 1.62;
    color: #b3ab9c;
    max-width: 420px;
    margin: 0 0 40px;
  }
  .contact__mark {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
  }
  .contact__the {
    font-family: var(--font-headline);
    font-size: 15px;
    color: #b3ab9c;
  }
  .contact__name {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: #f1ece2;
  }
  .contact__co {
    font-family: var(--font-headline);
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .section__pad,
    .dark__inner,
    .contact__grid {
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .hero {
      padding-top: 64px;
      padding-bottom: 64px;
    }
  }
</style>
